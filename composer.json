{
    "name": "sslcommerz/laravel",
    "description": "Production-ready Laravel package for SSLCOMMERZ payment gateway integration (API v4)",
    "keywords": [
        "sslcommerz",
        "laravel",
        "payment",
        "gateway",
        "bangladesh",
        "bdt"
    ],
    "homepage": "https://github.com/sslcommerz/SSLCommerz-Laravel",
    "support": {
        "issues": "https://github.com/sslcommerz/SSLCommerz-Laravel/issues",
        "source": "https://github.com/sslcommerz/SSLCommerz-Laravel"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "SSLCOMMERZ",
            "email": "developer@sslcommerz.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/log": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sslcommerz\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sslcommerz\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sslcommerz\\Laravel\\SslcommerzServiceProvider"
            ],
            "aliases": {
                "SSLCOMMERZ": "Sslcommerz\\Laravel\\Facades\\SSLCOMMERZ"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
